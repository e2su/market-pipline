# Copy this file to .env and fill in your own values.
# .env is git-ignored. Never commit real credentials.

ALPHA_VANTAGE_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
S3_BUCKET_NAME=

# Where the loader writes and the dashboard reads: redshift or postgres.
# docker-compose.prod.yml always uses postgres.
WAREHOUSE=redshift

# Postgres (used when WAREHOUSE=postgres, and by docker-compose.prod.yml)
POSTGRES_DB=market
POSTGRES_USER=market
POSTGRES_PASSWORD=

REDSHIFT_HOST=
REDSHIFT_PORT=5439
REDSHIFT_DB=dev
REDSHIFT_USER=
REDSHIFT_PASSWORD=
# Recommended: an IAM role attached to your Redshift namespace that can read the bucket.
# When set, COPY uses the role instead of sending your access keys to Redshift.
REDSHIFT_IAM_ROLE=

# Optional tuning (defaults shown)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
STOCK_SYMBOLS=AAPL,MSFT,GOOGL,AMZN
# Alpha Vantage's free tier allows 25 requests/day, so poll the 4 symbols every 4 hours.
STOCK_POLL_INTERVAL_SECONDS=14400
# A trade is flagged as a SPIKE when it is this many percent away from the previous batch's average.
ANOMALY_THRESHOLD_PCT=0.5
LOADER_INTERVAL_SECONDS=60
DASHBOARD_REFRESH_SECONDS=30
